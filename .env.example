# Copy to .env for local runs (never commit .env). On GitHub these go in repo Secrets / Variables.
SOURCE_URL=https://source.example.com
TARGET_URL=https://board.example.com
SOURCE_EMAIL=you@example.com
SOURCE_PASSWORD=your-source-password
# Password for your data: the web page asks for it, and the database checks it.
DATA_PASSWORD=pick-a-long-random-passphrase

AUTO_UNLOCK=true
# 0 = unlock every new post, no limit
MAX_UNLOCKS_PER_RUN=0
# Keep only posts created in the last N hours
WINDOW_HOURS=24

# Local only: show the browser window / use your installed Chrome instead of Playwright's
HEADLESS=true
BROWSER_CHANNEL=

# Groq AI rewrite (leave empty to skip). Rules: prompts/rewrite-rules.md, layouts: prompts/formats.md
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Job board posting (leave empty to skip). New jobs are posted after each scrape.
TARGET_EMAIL=
TARGET_PASSWORD=
AUTO_POST=true
# 0 = no limit
MAX_POSTS_PER_RUN=0

# Supabase database
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Only for npm run db:setup (from your PC)
SUPABASE_DB_PASSWORD=
SUPABASE_DB_HOST=aws-0-<region>.pooler.supabase.com
